我先读取现有 `ui/app.js` 及相关 preload/API 约定，确保输出的完整代码能直接接入当前 Electron 项目。同时我会确认现有 HTML 的容器和样式选择器，避免脚本使用与页面结构不一致的元素。(() => {
  'use strict';

  const api = window.api;
  const WHATSAPP_URL = 'https://web.whatsapp.com';
  const accounts = new Map();
  let activeAccountId = null;

  const styles = `
    :root {
      color-scheme: dark;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei",
        "PingFang SC", Arial, sans-serif;
      background: #111b21;
      color: #e9edef;
      font-size: 14px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: #111b21;
    }

    button,
    input {
      font: inherit;
    }

    button {
      border: 0;
    }

    .app {
      display: flex;
      width: 100%;
      height: 100vh;
      min-width: 760px;
      background: #111b21;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      width: 300px;
      min-width: 260px;
      height: 100%;
      background: #202c33;
      border-right: 1px solid #303c43;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 68px;
      padding: 0 16px 0 20px;
      background: #202c33;
      border-bottom: 1px solid #303c43;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      border-radius: 50%;
      color: #111b21;
      background: #25d366;
      font-size: 20px;
      font-weight: 700;
    }

    .brand-title {
      overflow: hidden;
      color: #e9edef;
      font-size: 16px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .add-button {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      color: #aebac1;
      background: transparent;
      cursor: pointer;
      font-size: 25px;
      line-height: 1;
    }

    .add-button:hover {
      color: #e9edef;
      background: #2a3942;
    }

    .account-list {
      flex: 1;
      padding: 8px 0;
      overflow-y: auto;
    }

    .account-item {
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 70px;
      padding: 10px 16px 10px 20px;
      color: #e9edef;
      background: transparent;
      cursor: pointer;
      text-align: left;
    }

    .account-item:hover {
      background: #2a3942;
    }

    .account-item.active {
      background: #374952;
    }

    .account-avatar {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: 12px;
      flex: 0 0 44px;
      border-radius: 50%;
      color: #111b21;
      background: #8696a0;
      font-size: 18px;
      font-weight: 600;
      text-transform: uppercase;
    }

    .account-info {
      min-width: 0;
      flex: 1;
    }

    .account-name {
      overflow: hidden;
      margin-bottom: 4px;
      color: #e9edef;
      font-size: 15px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .account-status {
      overflow: hidden;
      color: #8696a0;
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .account-delete {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      margin-left: 6px;
      border-radius: 6px;
      color: #8696a0;
      background: transparent;
      cursor: pointer;
      font-size: 18px;
      opacity: 0;
    }

    .account-item:hover .account-delete,
    .account-item.active .account-delete {
      opacity: 1;
    }

    .account-delete:hover {
      color: #f15c6d;
      background: #3b3137;
    }

    .empty-state {
      padding: 40px 24px;
      color: #8696a0;
      font-size: 13px;
      line-height: 1.7;
      text-align: center;
    }

    .content {
      position: relative;
      min-width: 0;
      flex: 1;
      height: 100%;
      background: #111b21;
    }

    .webview-container {
      position: absolute;
      inset: 0;
    }

    webview {
      display: none;
      width: 100%;
      height: 100%;
      border: 0;
      background: #111b21;
    }

    webview.active {
      display: flex;
    }

    .content-empty {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      color: #8696a0;
      background: #111b21;
      text-align: center;
    }

    .content-empty-inner {
      max-width: 340px;
      padding: 24px;
    }

    .content-empty-icon {
      margin-bottom: 14px;
      color: #25d366;
      font-size: 44px;
    }

    .content-empty-title {
      margin-bottom: 8px;
      color: #d1d7db;
      font-size: 18px;
      font-weight: 500;
    }

    .content-empty-text {
      color: #8696a0;
      font-size: 13px;
      line-height: 1.6;
    }

    .modal-backdrop {
      position: fixed;
      z-index: 10;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(11, 20, 26, 0.72);
    }

    .modal-backdrop.visible {
      display: flex;
    }

    .modal {
      width: min(400px, calc(100vw - 40px));
      padding: 24px;
      border: 1px solid #3b4a52;
      border-radius: 8px;
      background: #202c33;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    }

    .modal-title {
      margin: 0 0 20px;
      color: #e9edef;
      font-size: 18px;
      font-weight: 600;
    }

    .modal-label {
      display: block;
      margin-bottom: 8px;
      color: #aebac1;
      font-size: 13px;
    }

    .modal-input {
      width: 100%;
      height: 42px;
      padding: 0 12px;
      border: 1px solid #53636b;
      border-radius: 6px;
      outline: none;
      color: #e9edef;
      background: #111b21;
    }

    .modal-input:focus {
      border-color: #25d366;
    }

    .modal-error {
      min-height: 20px;
      margin-top: 8px;
      color: #f15c6d;
      font-size: 12px;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 14px;
    }

    .modal-button {
      min-width: 76px;
      height: 36px;
      padding: 0 14px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
    }

    .modal-button.cancel {
      color: #c8d1d5;
      background: #2a3942;
    }

    .modal-button.cancel:hover {
      background: #374952;
    }

    .modal-button.confirm {
      color: #111b21;
      background: #25d366;
    }

    .modal-button.confirm:hover {
      background: #42df7c;
    }

    .modal-button:disabled {
      cursor: wait;
      opacity: 0.55;
    }
  `;

  function createElement(tag, className, text) {
    const element = document.createElement(tag);
    if (className) element.className = className;
    if (text !== undefined) element.textContent = text;
    return element;
  }

  function normalizeAccount(value) {
    const account = value && value.account ? value.account : value;
    if (!account) return null;

    const id = account.id ?? account.accountId ?? account.uuid;
    const name = account.name ?? account.title ?? `账号 ${id}`;

    if (id === undefined || id === null) return null;

    return {
      id: String(id),
      name: String(name || `账号 ${id}`)
    };
  }

  function accountInitial(name) {
    return String(name || '?').trim().slice(0, 1).toUpperCase() || '?';
  }

  function createLayout() {
    document.title = 'WhatsApp 多开客户端';
    document.head.innerHTML = '';
    const style = document.createElement('style');
    style.textContent = styles;
    document.head.appendChild(style);

    document.body.innerHTML = '';

    const app = createElement('main', 'app');
    const sidebar = createElement('aside', 'sidebar');
    const sidebarHeader = createElement('header', 'sidebar-header');
    const brand = createElement('div', 'brand');
    const brandMark = createElement('div', 'brand-mark', 'W');
    const brandTitle = createElement('div', 'brand-title', 'WhatsApp 多开');
    const addButton = createElement('button', 'add-button', '+');

    addButton.type = 'button';
    addButton.title = '添加账号';
    addButton.setAttribute('aria-label', '添加账号');
    addButton.addEventListener('click', openAddModal);

    brand.append(brandMark, brandTitle);
    sidebarHeader.append(brand, addButton);

    const accountList = createElement('div', 'account-list');
    accountList.id = 'account-list';

    sidebar.append(sidebarHeader, accountList);

    const content = createElement('section', 'content');
    const contentEmpty = createElement('div', 'content-empty');
    contentEmpty.id = 'content-empty';
    contentEmpty.innerHTML = `
      <div class="content-empty-inner">
        <div class="content-empty-icon">◉</div>
        <div class="content-empty-title">选择一个 WhatsApp 账号</div>
        <div class="content-empty-text">从左侧选择账号，或添加一个新账号开始使用。</div>
      </div>
    `;

    const webviewContainer = createElement('div', 'webview-container');
    webviewContainer.id = 'webview-container';

    content.append(contentEmpty, webviewContainer);
    app.append(sidebar, content);

    const modalBackdrop = createElement('div', 'modal-backdrop');
    modalBackdrop.id = 'modal-backdrop';
    modalBackdrop.innerHTML = `
      <form class="modal" id="add-account-form">
        <h2 class="modal-title">添加 WhatsApp 账号</h2>
        <label class="modal-label" for="account-name-input">账号名称</label>
        <input
          class="modal-input"
          id="account-name-input"
          name="name"
          type="text"
          maxlength="40"
          autocomplete="off"
          placeholder="例如：工作账号"
        />
        <div class="modal-error" id="modal-error" role="alert"></div>
        <div class="modal-actions">
          <button class="modal-button cancel" id="modal-cancel" type="button">取消</button>
          <button class="modal-button confirm" id="modal-confirm" type="submit">添加</button>
        </div>
      </form>
    `;

    document.body.append(app, modalBackdrop);

    document.getElementById('modal-cancel').addEventListener('click', closeAddModal);
    modalBackdrop.addEventListener('click', (event) => {
      if (event.target === modalBackdrop) closeAddModal();
    });

    document.getElementById('add-account-form').addEventListener('submit', handleAddAccount);
  }

  function openAddModal() {
    const backdrop = document.getElementById('modal-backdrop');
    const input = document.getElementById('account-name-input');
    const error = document.getElementById('modal-error');

    error.textContent = '';
    input.value = '';
    backdrop.classList.add('visible');
    requestAnimationFrame(() => input.focus());
  }

  function closeAddModal() {
    document.getElementById('modal-backdrop').classList.remove('visible');
  }

  function setModalBusy(busy) {
    document.getElementById('modal-confirm').disabled = busy;
    document.getElementById('modal-cancel').disabled = busy;
    document.getElementById('account-name-input').disabled = busy;
  }

  async function handleAddAccount(event) {
    event.preventDefault();

    const input = document.getElementById('account-name-input');
    const error = document.getElementById('modal-error');
    const name = input.value.trim();

    if (!name) {
      error.textContent = '请输入账号名称';
      input.focus();
      return;
    }

    if (!api || !api.accounts || typeof api.accounts.add !== 'function') {
      error.textContent = '账号接口不可用';
      return;
    }

    setModalBusy(true);
    error.textContent = '';

    try {
      const result = await api.accounts.add(name);
      const account = normalizeAccount(result);

      if (!account) {
        throw new Error('添加账号后未返回有效账号信息');
      }

      closeAddModal();
      addAccount(account);
      await selectAccount(account.id);
    } catch (err) {
      error.textContent = err && err.message ? err.message : '添加账号失败';
    } finally {
      setModalBusy(false);
    }
  }

  function createWebview(account) {
    const webview = document.createElement('webview');
    const partition = `persist:whatsapp-${account.id}`;

    webview.className = 'account-webview';
    webview.dataset.accountId = account.id;
    webview.setAttribute('src', WHATSAPP_URL);
    webview.setAttribute('partition', partition);
    webview.setAttribute(
      'webpreferences',
      'contextIsolation=yes,nodeIntegration=no,sandbox=yes'
    );
    webview.setAttribute('allowpopups', 'false');

    webview.addEventListener('did-start-loading', () => {
      updateAccountStatus(account.id, '正在加载...');
    });

    webview.addEventListener('did-stop-loading', () => {
      updateAccountStatus(account.id, '已连接');
    });

    webview.addEventListener('did-fail-load', (event) => {
      if (event.isMainFrame) {
        updateAccountStatus(account.id, '加载失败');
      }
    });

    webview.addEventListener('dom-ready', () => {
      updateAccountStatus(account.id, '已连接');
    });

    webview.addEventListener('destroyed', () => {
      updateAccountStatus(account.id, '未连接');
    });

    document.getElementById('webview-container').appendChild(webview);
    return webview;
  }

  function addAccount(account) {
    if (accounts.has(account.id)) {
      accounts.get(account.id).data = account;
      return accounts.get(account.id);
    }

    const item = {
      data: account,
      element: null,
      webview: createWebview(account),
      statusElement: null
    };

    accounts.set(account.id, item);
    renderAccountItem(item);
    return item;
  }

  function renderAccountItem(item) {
    const { data: account } = item;
    const list = document.getElementById('account-list');
    const row = createElement('div', 'account-item');
    const avatar = createElement('div', 'account-avatar', accountInitial(account.name));
    const info = createElement('div', 'account-info');
    const name = createElement('div', 'account-name', account.name);
    const status = createElement('div', 'account-status', '正在加载...');
    const deleteButton = createElement('button', 'account-delete', '×');

    row.dataset.accountId = account.id;
    row.title = account.name;
    deleteButton.type = 'button';
    deleteButton.title = `删除${account.name}`;
    deleteButton.setAttribute('aria-label', `删除${account.name}`);

    deleteButton.addEventListener('click', async (event) => {
      event.stopPropagation();
      await deleteAccount(account.id);
    });

    row.addEventListener('click', () => selectAccount(account.id));

    info.append(name, status);
    row.append(avatar, info, deleteButton);
    list.appendChild(row);

    item.element = row;
    item.statusElement = status;
  }

  function updateAccountStatus(id, statusText) {
    const item = accounts.get(String(id));
    if (item && item.statusElement) {
      item.statusElement.textContent = statusText;
    }
  }

  async function selectAccount(id) {
    const accountId = String(id);
    const item = accounts.get(accountId);
    if (!item) return;

    activeAccountId = accountId;

    for (const [currentId, currentItem] of accounts) {
      const active = currentId === accountId;
      currentItem.element.classList.toggle('active', active);
      currentItem.webview.classList.toggle('active', active);
      currentItem.webview.style.display = active ? 'flex' : 'none';
    }

    document.getElementById('content-empty').style.display = 'none';
  }

  async function deleteAccount(id) {
    const accountId = String(id);
    const item = accounts.get(accountId);
    if (!item) return;

    const accountName = item.data.name;
    const confirmed = window.confirm(
      `确定删除账号“${accountName}”吗？\n该账号的 WhatsApp 登录数据也会被清除。`
    );

    if (!confirmed) return;

    try {
      if (api && api.accounts) {
        if (typeof api.accounts.delete === 'function') {
          await api.accounts.delete(accountId);
        } else if (typeof api.accounts.remove === 'function') {
          await api.accounts.remove(accountId);
        } else {
          throw new Error('删除账号接口不可用');
        }
      }

      item.webview.remove();
      item.element.remove();
      accounts.delete(accountId);

      if (activeAccountId === accountId) {
        activeAccountId = null;
        const nextAccount = accounts.values().next().value;

        if (nextAccount) {
          await selectAccount(nextAccount.data.id);
        } else {
          document.getElementById('content-empty').style.display = 'grid';
        }
      }
    } catch (err) {
      window.alert(err && err.message ? err.message : '删除账号失败');
    }
  }

  async function loadAccounts() {
    const list = document.getElementById('account-list');

    if (!api || !api.accounts || typeof api.accounts.list !== 'function') {
      list.innerHTML = '<div class="empty-state">账号接口不可用</div>';
      return;
    }

    try {
      const result = await api.accounts.list();
      const savedAccounts = Array.isArray(result)
        ? result
        : Array.isArray(result && result.accounts)
          ? result.accounts
          : [];

      const normalizedAccounts = savedAccounts
        .map(normalizeAccount)
        .filter(Boolean);

      if (!normalizedAccounts.length) {
        list.innerHTML = '<div class="empty-state">还没有账号<br>点击右上角 + 添加账号</div>';
        return;
      }

      normalizedAccounts.forEach(addAccount);
      await selectAccount(normalizedAccounts[0].id);
    } catch (err) {
      list.innerHTML = '<div class="empty-state">账号加载失败</div>';
      console.error('加载账号列表失败:', err);
    }
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeAddModal();
    }
  });

  createLayout();
  loadAccounts();
})();
