<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
  >
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp 多开客户端</title>
  <link rel="stylesheet" href="./style.css">
</head>
<body>
  <main class="app-shell">
    <aside class="sidebar" aria-label="账号管理">
      <header class="sidebar-header">
        <div class="brand">
          <div class="brand-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img">
              <path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.51 0 .16 5.35.16 11.92c0 2.1.55 4.15 1.6 5.97L.06 24l6.25-1.64a11.87 11.87 0 0 0 5.77 1.48h.01c6.57 0 11.91-5.35 11.91-11.92 0-3.18-1.24-6.16-3.48-8.44ZM12.09 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.71.98.99-3.62-.23-.37a9.85 9.85 0 0 1-1.52-5.28c0-5.46 4.45-9.9 9.91-9.9 2.65 0 5.14 1.03 7.01 2.91a9.86 9.86 0 0 1 2.9 7.02c-.01 5.45-4.45 9.89-9.95 9.89Zm5.42-7.41c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
            </svg>
          </div>
          <div class="brand-copy">
            <h1>WhatsApp 多开</h1>
            <span>账号管理中心</span>
          </div>
        </div>
      </header>

      <section class="account-section">
        <div class="section-heading">
          <span>我的账号</span>
          <span id="account-count" class="account-count">0</span>
        </div>

        <div
          id="account-list"
          class="account-list"
          role="listbox"
          aria-label="WhatsApp 账号列表"
          aria-orientation="vertical"
        >
          <div id="account-empty" class="account-empty">
            <div class="empty-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0h14Zm-2-9h2V9h-2V7h-2v2h-2v2h2v2h2v-2Z"/>
              </svg>
            </div>
            <p>还没有账号</p>
            <span>添加账号后即可开始使用</span>
          </div>
        </div>
      </section>

      <footer class="sidebar-footer">
        <button id="add-account-btn" class="add-account-btn" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span>添加账号</span>
        </button>
        <div class="app-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>本地安全运行</span>
        </div>
      </footer>
    </aside>

    <section class="workspace" aria-label="WhatsApp 工作区">
      <header class="workspace-header">
        <div class="current-account">
          <div id="current-account-avatar" class="current-avatar" aria-hidden="true">W</div>
          <div class="current-account-info">
            <strong id="current-account-name">未选择账号</strong>
            <span id="current-account-status">请从左侧添加或选择账号</span>
          </div>
        </div>

        <div class="workspace-actions">
          <button
            id="refresh-account-btn"
            class="icon-button"
            type="button"
            title="刷新当前账号"
            aria-label="刷新当前账号"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 11a8 8 0 0 0-14.9-4H8V5H3v5h2V8.45A6 6 0 1 1 6.34 15l-1.73 1A8 8 0 0 0 20 11Z"/>
            </svg>
          </button>
          <button
            id="delete-account-btn"
            class="icon-button danger-button"
            type="button"
            title="删除当前账号"
            aria-label="删除当前账号"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm-3 6h12l-.8 11.2a2 2 0 0 1-2 1.8H8.8a2 2 0 0 1-2-1.8L6 9Zm3 2v8h2v-8H9Zm4 0v8h2v-8h-2Z"/>
            </svg>
          </button>
        </div>
      </header>

      <div id="webview-container" class="webview-container">
        <div id="workspace-empty" class="workspace-empty">
          <div class="workspace-empty-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 2a10 10 0 1 0 9.95 11.05A10 10 0 0 0 12 2Zm5.1 14.1-1.45 1.45-3.66-3.66A2.9 2.9 0 0 1 8.5 11.1a2.9 2.9 0 0 1 5.8 0c0 .58-.17 1.11-.46 1.56l3.26 3.44ZM12 9.8a1.3 1.3 0 1 0 1.3 1.3A1.3 1.3 0 0 0 12 9.8Z"/>
            </svg>
          </div>
          <h2>欢迎使用 WhatsApp 多开</h2>
          <p>选择一个账号，或添加新的 WhatsApp 账号</p>
          <button id="empty-add-account-btn" class="primary-action-btn" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            <span>添加账号</span>
          </button>
        </div>
      </div>

      <div id="loading-indicator" class="loading-indicator" hidden>
        <span class="loading-spinner" aria-hidden="true"></span>
        <span>正在加载 WhatsApp Web...</span>
      </div>
    </section>
  </main>

  <div id="confirm-dialog" class="dialog-backdrop" hidden>
    <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
      <div class="dialog-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z"/>
        </svg>
      </div>
      <h2 id="confirm-title">删除账号</h2>
      <p id="confirm-message">确定要删除当前账号吗？该账号的登录数据也会被清除。</p>
      <div class="dialog-actions">
        <button id="cancel-delete-btn" class="secondary-action-btn" type="button">取消</button>
        <button id="confirm-delete-btn" class="danger-action-btn" type="button">删除账号</button>
      </div>
    </section>
  </div>

  <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  <script src="./app.js"></script>
</body>
</html>
