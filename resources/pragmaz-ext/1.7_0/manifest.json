{
  "action": {
    "default_icon": "img/icon128.png"
  },
  "background": {
    "service_worker": "js/service-worker.js"
  },
  "content_scripts": [
    {
      "css": [
        "css/pragmaz.min.css"
      ],
      "js": [
        "js/content-bridge.js",
        "js/public/pragmaz-init.js",
        "js/content-utils.js"
      ],
      "matches": [
        "*://web.whatsapp.com/*",
        "http://localhost:1842/*",
        "http://127.0.0.1:1843/*",
        "http://localhost:1843/*"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "enabled": true,
        "id": "pragmaz_rules",
        "path": "rules.json"
      }
    ]
  },
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "host_permissions": [
    "*://*.whatsapp.com/*",
    "*://pragmaz.ai/*",
    "*://*.whatsapp.net/*",
    "http://localhost:1842/*",
    "http://127.0.0.1:1843/*",
    "http://localhost:1843/*"
  ],
  "icons": {
    "128": "img/icon128.png",
    "16": "img/icon16.png",
    "48": "img/icon48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "__MSG_name__",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "browsingData",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "short_name": "Pragmaz",
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.7",
  "web_accessible_resources": [
    {
      "matches": [
        "*://web.whatsapp.com/*",
        "http://localhost:1842/*"
      ],
      "resources": [
        "js/public/*",
        "/_locales/*",
        "img/*"
      ]
    }
  ]
}