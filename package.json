{
  "name": "geek",
  "productName": "极客",
  "version": "1.2.4",
  "description": "极客——多平台多账号聊天客户端（WhatsApp / Telegram / LINE）",
  "main": "src/main.cjs",
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist:test": "electron-builder --win --publish never",
    "dist": "node scripts/release-build.cjs"
  },
  "devDependencies": {
    "electron": "^35.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@wppconnect/wa-js": "^4.3.0",
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@35.5.1": true
  }
}
