+      if (cleared?.editor === true) throw createCodeError('TG_NATIVE_ATTACH_STALE_EDITOR');
+    }
+
+    chooser = waitForFileChooser({
+      send,
+      onEvent,
+      files: filePaths,
+      timeoutMs: options.chooserTimeoutMs,
